for x in range(32):
    keycodes_v6.kc["MO({})".format(x)] = keycodes_v6.kc["QK_MOMENTARY"] + x
    keycodes_v6.kc["DF({})".format(x)] = keycodes_v6.kc["QK_DEF_LAYER"] + x
    keycodes_v6.kc["TG({})".format(x)] = keycodes_v6.kc["QK_TOGGLE_LAYER"] + x
